{
  "manifest_version": 3,
  "name": "Preclass: Forum to ChatGPT",
  "version": "0.1.0",
  "description": "Collect, review, and bring your preclass readings to ChatGPT. No API key.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://forum.minerva.edu/*",
    "https://forum.minerva.kgi.edu/*"
  ],
  "action": {
    "default_title": "Collect Preclass",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "response.js",
        "handoff.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}
